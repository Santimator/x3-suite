[Unit]
Description=X3 suite OPDS server — serves built EPUBs to the reader over WiFi
Documentation=https://github.com/Santimator/x3-suite
After=network-online.target
Wants=network-online.target

[Service]
# Two things to edit: the account whose home holds the books, and where you
# cloned the repo. Everything else — port, library roots, whether auth is on —
# comes from tools/opds-server/config.json, so this file stays put once it works.
User=CHANGEME
ExecStart=/usr/bin/python3 /home/CHANGEME/x3-suite/tools/opds-server/scripts/serve_opds.py

Restart=on-failure
RestartSec=5

# The server reads and never writes, so it can be confined tightly:
# the whole filesystem read-only, home readable but not writable.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
