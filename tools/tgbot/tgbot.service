[Unit]
Description=X3 suite Telegram bot — the suite, operated from a phone
Documentation=https://github.com/Santimator/x3-suite
After=network-online.target
Wants=network-online.target

[Service]
# Do not hand-edit the two placeholders — let the shell fill them in, from the
# clone you are standing in. Typing a path by hand is how you get
# /home/server_projects/... instead of /home/you/server_projects/..., and the
# error that produces names a directory rather than the mistake:
#
#   cd /path/to/x3-suite
#   mkdir -p tools/tgbot/state
#   sed -e "s|CHANGEME_REPO|$PWD|g" -e "s|CHANGEME_USER|$(id -un)|g" \
#       tools/tgbot/tgbot.service | sudo tee /etc/systemd/system/tgbot.service
#
# The mkdir matters: ReadWritePaths below refuses to start on a directory that
# does not exist yet, and tools/tgbot/state/ is gitignored.
User=CHANGEME_USER
WorkingDirectory=CHANGEME_REPO
ExecStart=/usr/bin/python3 CHANGEME_REPO/tools/tgbot/scripts/bot.py

Restart=on-failure
RestartSec=10

# Unlike opds-server, this one *writes*: it converts wallpapers into
# workspace/, stages PDFs there, keeps its queue in tools/tgbot/state/, and lets
# push_wallpaper.py remember the reader's address in tools/wallpaper-maker/
# last-device.json. So the filesystem is still read-only everywhere else, and
# those three paths are opened back up by name. Copying opds-server's unit
# verbatim would give you a bot that dies on its first photo.
#
# The leading '-' means "skip this one if it is missing" — without it a
# vanished state/ fails the whole unit at namespace setup, with a 226/NAMESPACE
# and no mention of what systemd actually wanted.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-CHANGEME_REPO/workspace
ReadWritePaths=-CHANGEME_REPO/tools/tgbot/state
ReadWritePaths=-CHANGEME_REPO/tools/wallpaper-maker

PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
