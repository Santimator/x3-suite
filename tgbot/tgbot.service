[Unit]
Description=X3 suite Telegram bot — the suite, operated from a phone
Documentation=https://github.com/Santimator/x3-suite
After=network-online.target
Wants=network-online.target

[Service]
# Two things to edit: the account that owns the repo and the books, and where
# you cloned it. Everything else — which Telegram user is served, where the
# workspace is — comes from tgbot/config.json, so this file stays put once it
# works.
User=CHANGEME
WorkingDirectory=/home/CHANGEME/x3-suite
ExecStart=/usr/bin/python3 /home/CHANGEME/x3-suite/tgbot/scripts/bot.py

Restart=on-failure
RestartSec=10

# Unlike opds-server, this one *writes*: it converts wallpapers into
# workspace/, stages PDFs there, keeps its queue in tgbot/state/, and lets
# push_wallpaper.py remember the reader's address in wallpaper-maker/
# last-device.json. So the filesystem is still read-only everywhere else, and
# those three paths are opened back up by name. Copying opds-server's unit
# verbatim would give you a bot that dies on its first photo.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/CHANGEME/x3-suite/workspace
ReadWritePaths=/home/CHANGEME/x3-suite/tgbot/state
ReadWritePaths=/home/CHANGEME/x3-suite/wallpaper-maker

PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
